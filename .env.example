# Copy this file to .env and fill in real values.
# .env itself is gitignored -- never commit it.

# Docker only: this PC's Wi-Fi IPv4 from `ipconfig` (e.g. 192.168.254.107).
# The Expo container puts it in the QR code and in the app's API address.
HOST_LAN_IP=
# HTTPS tunnel for Google Sign-In on the phone ("tunnel" service).
# MOBILE_API_BASE_URL=https://<tunnel-id>-3000.<region>.devtunnels.ms/api
# DEVTUNNEL_ID=<tunnel-id>.<region>

# Server
PORT=3000
NODE_ENV=production
# Base URL for certificate QR/verify links. Defaults to the dashboard's own address.
# PUBLIC_BASE_URL=

# MySQL in Docker (localhost:3307). The app container uses DB_HOST=db.
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=geoattend_root
DB_NAME=geoattend_pro
# MYSQL_ROOT_PASSWORD=geoattend_root

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
SESSION_SECRET=replace_with_a_different_long_random_secret

# Default admin seeded by database/seed.js -- log in once after deploying
# and change this password immediately (Settings > Admin Accounts).
DEFAULT_ADMIN_EMAIL=admin@my.cspc.edu.ph
DEFAULT_ADMIN_PASSWORD=replace_with_a_strong_temporary_password

# Google Maps (Google Cloud Console > APIs & Services > Credentials).
# Restrict this key to your deployed domain before going live.
GOOGLE_MAPS_API_KEY=

# Google OAuth Web client ID for "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Gmail SMTP (needs an App Password). Tried first.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Brevo HTTP API fallback. Unset in dev: codes are printed to the console.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=GeoAttend
# Apps Script relay fallback (see scripts/mail-relay.gs).
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=

# Max GPS accuracy (m) accepted for attendance.
ATTENDANCE_MAX_ACCURACY_METERS=100

# Geo-anomaly detection (two phones at the same spot).
ANOMALY_DISTANCE_METERS=5
ANOMALY_WINDOW_SECONDS=30
ANOMALY_RECHECK_SECONDS=30

# Optional buffalo_l models (larger, more accurate).
# FACE_DETECTOR_MODEL_PATH=./models/det_10g.onnx
# FACE_DETECTOR_INPUT_SIZE=640
# FACE_DETECTOR_SCORE_THRESHOLD=0.5
# FACE_DETECTOR_NMS_THRESHOLD=0.4
# FACE_MODEL_PATH=./models/w600k_r50.onnx
# FACE_INPUT_SIZE=112
# FACE_MATCH_THRESHOLD=0.5
