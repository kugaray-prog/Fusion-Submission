                            <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; display: block;">Event</label>
                            <select id="rpt-event" class="geo-input" style="margin:0;" onchange="G_App.reports.syncPeriodToEvent()">
                                <option value="all">All Events</option>
                            </select>
                        </div>
                        <div>
                            <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; display: block;">Duty Status</label>
                            <select id="rpt-status" class="geo-input" style="margin:0;">
