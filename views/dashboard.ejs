        .splash-ring:nth-child(3) { animation-delay: 1.2s; }
        .splash-name { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; font-size: 1.6rem; font-weight: 800; letter-spacing: -0.02em; animation: splashRise 0.6s ease both 0.1s; }
        .splash-sub { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; font-size: 0.85rem; opacity: 0.75; margin-top: -16px; animation: splashRise 0.6s ease both 0.2s; }
        .splash-bar { width: 160px; height: 4px; border-radius: 999px; background: rgba(255, 255, 255, 0.2); overflow: hidden; animation: splashRise 0.6s ease both 0.3s; }
        .splash-bar span { display: block; width: 40%; height: 100%; border-radius: inherit; background: #fff; animation: splashSlide 1.1s ease-in-out infinite; }
        @keyframes splashRipple { 0% { transform: scale(1); opacity: 0.8; } 100% { transform: scale(1.9); opacity: 0; } }
        @keyframes splashBreath { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.04); } }
        @keyframes splashSlide { 0% { transform: translateX(-110%); } 100% { transform: translateX(260%); } }
        @keyframes splashRise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
        /* Login card: its parts rise in one after another once the splash leaves */
        body.splash-done #login-screen .login-card > * { animation: loginRise 0.5s cubic-bezier(0.2, 0.7, 0.3, 1) both; }
        body.splash-done #login-screen .login-card > *:nth-child(2) { animation-delay: 0.05s; }
        body.splash-done #login-screen .login-card > *:nth-child(3) { animation-delay: 0.1s; }
        body.splash-done #login-screen .login-card > *:nth-child(n+4) { animation-delay: 0.15s; }
        body.splash-done #login-screen .login-card { animation: loginCardIn 0.5s cubic-bezier(0.2, 0.7, 0.3, 1) both; }
        @keyframes loginRise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
        @keyframes loginCardIn { from { opacity: 0; transform: translateY(16px) scale(0.98); } to { opacity: 1; transform: none; } }
        @media (prefers-reduced-motion: reduce) {
