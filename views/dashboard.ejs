                    </div>
                    <div class="ev-toolbar">
                        <div class="ev-search">
                            <i data-lucide="search"></i>
                            <input type="search" id="events-search" placeholder="Search by title or venue..." class="geo-input" aria-label="Search events" oninput="G_App.events.onSearch()">
                        </div>
                        <div class="ev-chips" id="events-status-chips" role="group" aria-label="Filter by status">
                            <button type="button" data-status="all" class="active" aria-pressed="true" onclick="G_App.events.setStatus('all')">All <span class="ev-chip-count" data-count="all"></span></button>
                            <button type="button" data-status="ongoing" aria-pressed="false" onclick="G_App.events.setStatus('ongoing')">Ongoing <span class="ev-chip-count" data-count="ongoing"></span></button>
                            <button type="button" data-status="upcoming" aria-pressed="false" onclick="G_App.events.setStatus('upcoming')">Upcoming <span class="ev-chip-count" data-count="upcoming"></span></button>
                            <button type="button" data-status="completed" aria-pressed="false" onclick="G_App.events.setStatus('completed')">Completed <span class="ev-chip-count" data-count="completed"></span></button>
