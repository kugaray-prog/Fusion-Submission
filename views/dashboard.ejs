        /* Face Verification — liveness challenge overlay (GCash-style: dark
           camera background, a bright circular guide ring that reacts in
           real time, and a light rounded bottom sheet for instructions). */
        #face-guide-frame { transition: border-color 0.25s ease, box-shadow 0.25s ease; }
        /* "A face is visible" is a different, lower-stakes fact than "the correct
           action was confirmed" -- state-found deliberately stays neutral (never
           green) so it can't be misread as a success signal before the prompted
           action is actually verified. Only state-pass (a genuinely confirmed
           action) gets the green/glow treatment. */
        #face-guide-frame.state-found { border-color: var(--accent) !important; }
        #face-guide-frame.state-searching { border-color: var(--warning) !important; }
        #face-guide-frame.state-pass { border-color: var(--success) !important; box-shadow: 0 0 0 10px rgba(5,205,153,0.2); }
        #face-guide-frame.state-fail { border-color: var(--danger) !important; box-shadow: 0 0 0 8px rgba(238,93,80,0.16); }
        #face-liveness-banner { position: absolute; left: 0; right: 0; bottom: 0; z-index: 6; padding: 18px 22px 22px; text-align: center; background: #fff; border-top-left-radius: 22px; border-top-right-radius: 22px; box-shadow: 0 -10px 30px rgba(112,144,176,0.18); }
        #face-liveness-banner::before { content: ''; display: block; width: 40px; height: 4px; border-radius: 2px; background: var(--border); margin: 0 auto 14px; }
        #face-liveness-instruction { font-size: 0.95rem; font-weight: 800; letter-spacing: 0.01em; margin-bottom: 12px; color: var(--text-main); }
        /* 3-2-1 countdown shown inside the guide ring before the check starts */
        #face-countdown { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 4; font-size: 5.5rem; font-weight: 800; line-height: 1; color: #fff; text-shadow: 0 4px 24px rgba(0,0,0,0.55); pointer-events: none; }
        #face-countdown.tick { animation: faceCountTick 0.9s ease-out; }
        @keyframes faceCountTick { 0% { transform: translate(-50%, -50%) scale(1.5); opacity: 0; } 25% { opacity: 1; } 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; } }
        @media (prefers-reduced-motion: reduce) { #face-countdown.tick { animation: none; } }
        #face-liveness-timer { margin-top: -4px; font-size: 0.75rem; font-weight: 700; color: var(--text-muted); font-variant-numeric: tabular-nums; }
        .liveness-dots { display: flex; justify-content: center; gap: 8px; }
        .liveness-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--border); transition: 0.3s; }
        .liveness-dot.done { background: var(--success); }
        .liveness-dot.active { background: var(--warning); box-shadow: 0 0 10px var(--warning); }
        .liveness-badge { padding: 4px 10px; border-radius: 10px; font-size: 0.68rem; font-weight: 800; text-transform: uppercase; }
        .liveness-badge.pass { background: #DCFCE7; color: var(--success); }
        .liveness-badge.fail { background: #FEE2E2; color: var(--danger); }
        .face-status-chip { position: absolute; top: 16px; left: 16px; z-index: 5; display: flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 20px; background: rgba(15,23,42,0.6); color: #fff; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; }
        .face-status-chip .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--warning); transition: background 0.25s ease; }
        .face-status-chip.state-found .dot { background: var(--accent); }
        .face-status-chip.state-pass .dot { background: var(--success); }
        .face-status-chip.state-fail .dot { background: var(--danger); }
        /* Verification page */
        .vf-tabs { margin-bottom: 22px; }
        .vf-tabs button svg { width: 16px; height: 16px; }
        .vf-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 24px; align-items: start; }
        @media (max-width: 1180px) { .vf-grid { grid-template-columns: minmax(0, 1fr); } }
        .vf-capture { display: flex; flex-direction: column; }
        .vf-head { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 20px; }
        .vf-head h3 { font-weight: 800; font-size: 1.15rem; }
        .vf-head p { color: var(--text-muted); font-size: 0.85rem; margin-top: 2px; line-height: 1.45; }
        .vf-head-icon { width: 42px; height: 42px; flex-shrink: 0; border-radius: 12px; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; }
        .vf-head-icon svg { width: 20px; height: 20px; }
        .vf-label { display: block; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); margin-bottom: 6px; }
        .vf-select { margin-bottom: 6px; }
        .vf-hint { font-size: 0.75rem; color: var(--text-muted); margin-bottom: 16px; line-height: 1.45; }
        .vf-camera { position: relative; height: 380px; border-radius: var(--radius-lg); overflow: hidden; }
        .vf-camera-face { height: 440px; }
        .vf-action { width: 100%; margin-top: 16px; }
        .vf-sheet { position: absolute; left: 0; right: 0; bottom: 0; z-index: 4; padding: 16px 20px 20px; background: var(--bg-card); border-top-left-radius: 20px; border-top-right-radius: 20px; box-shadow: 0 -10px 30px rgba(11, 15, 26, 0.18); }
        #face-liveness-banner { background: var(--bg-card); }
        .vf-result { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 12px; align-items: start; margin-top: 16px; padding: 14px 16px; border-radius: var(--radius-md); background: var(--bg-body); border: 1px solid var(--border); border-left: 4px solid var(--border); transition: border-color 0.2s ease, background 0.2s ease; }
        .vf-result-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; background: var(--primary-light); color: var(--primary); }
        .vf-result-icon svg { width: 18px; height: 18px; }
        .vf-result-title { font-weight: 800; font-size: 0.95rem; color: var(--text-main); }
        .vf-result-lines { margin-top: 3px; font-size: 0.82rem; color: var(--text-muted); line-height: 1.5; }
        .vf-result-lines b { color: var(--text-main); font-weight: 700; }
        .vf-result.tone-busy { border-left-color: var(--accent); }
        .vf-result.tone-busy .vf-result-icon svg { animation: vfSpin 1s linear infinite; }
        .vf-result.tone-success { border-left-color: var(--success); }
        .vf-result.tone-success .vf-result-icon { background: #DCFCE7; color: #047857; }
        .vf-result.tone-error { border-left-color: var(--danger); }
        .vf-result.tone-error .vf-result-icon { background: #FEE2E2; color: #B91C1C; }
        @keyframes vfSpin { to { transform: rotate(360deg); } }
        .vf-records-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 14px; }
        .vf-records-head h3 { font-weight: 800; font-size: 1.15rem; }
        .vf-live { display: inline-flex; align-items: center; gap: 6px; font-size: 0.72rem; font-weight: 700; color: var(--text-muted); }
        .vf-live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 0 rgba(5, 205, 153, 0.5); animation: vfPulse 2s ease-out infinite; }
        @keyframes vfPulse { 0% { box-shadow: 0 0 0 0 rgba(5, 205, 153, 0.5); } 100% { box-shadow: 0 0 0 8px rgba(5, 205, 153, 0); } }
        .vf-list { display: flex; flex-direction: column; gap: 8px; max-height: 640px; overflow-y: auto; margin: 0 -6px; padding: 0 6px 4px; }
        .vf-row { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 10px 12px; border-radius: var(--radius-md); border: 1px solid var(--border); background: var(--bg-card); }
        .vf-row:hover { background: var(--bg-body); }
        .vf-row .photo-thumb, .vf-row .photo-missing { width: 48px; height: 48px; }
        .vf-row-name { font-weight: 700; font-size: 0.9rem; color: var(--text-main); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .vf-row-name.is-unknown { color: var(--text-muted); font-weight: 600; }
        .vf-row-meta { font-size: 0.75rem; color: var(--text-muted); margin-top: 2px; display: flex; flex-wrap: wrap; gap: 2px 8px; }
        .vf-row-side { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
        .vf-row-side small { font-size: 0.7rem; color: var(--text-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
        .vf-records { grid-column: 1 / -1; }
        .vf-result-card .vf-result { margin-top: 0; }
        .vf-result-card .vf-details { grid-template-columns: minmax(120px, max-content) minmax(0, 1fr); gap: 8px 16px; margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--border); font-size: 0.88rem; }
        .vf-table-wrap { overflow: auto; max-height: 560px; }
        .vf-table th { position: sticky; top: 0; z-index: 1; }
        .vf-table th, .vf-table td { padding: 10px 14px; white-space: nowrap; }
        .vf-table td { font-size: 0.85rem; }
        .vf-table .vf-cell-name { font-weight: 700; color: var(--text-main); }
        .vf-table .vf-cell-sub { display: block; font-size: 0.72rem; color: var(--text-muted); font-weight: 500; }
        .vf-table .vf-cell-muted { color: var(--text-muted); }
        .vf-table .vf-cell-num { text-align: right; font-variant-numeric: tabular-nums; }
        .vf-table .vf-cell-when { font-size: 0.78rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
        .vf-table .vf-col-actions { width: 1%; text-align: right; }
        .vf-table .vf-col-actions .btn-icon { margin-left: auto; }
        .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
        .vf-details { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 4px 14px; margin-top: 8px; font-size: 0.82rem; }
        .vf-details dt { color: var(--text-muted); font-weight: 600; }
        .vf-details dd { margin: 0; color: var(--text-main); font-weight: 600; overflow-wrap: anywhere; }
        .vf-empty { text-align: center; color: var(--text-muted); padding: 36px 10px; font-size: 0.88rem; border: 1px dashed var(--border); border-radius: var(--radius-md); }
        .photo-thumb { display: block; width: 44px; height: 44px; object-fit: cover; border-radius: 10px; border: 1px solid var(--border); }
        .photo-missing { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 10px; border: 1px dashed var(--border); background: var(--bg-body); color: var(--text-muted); }
        .photo-missing svg { width: 18px; height: 18px; }
        @media (prefers-reduced-motion: reduce) { .vf-live-dot, .vf-result.tone-busy .vf-result-icon svg { animation: none; } }
        /* Hint labels sit above the Start sheet instead of behind it */
        #face-idle-label { bottom: 158px !important; }
        #face-idle-sublabel { bottom: 138px !important; }
        body.dark-mode .vf-head-icon, body.dark-mode .vf-result.tone-idle .vf-result-icon, body.dark-mode .vf-result.tone-busy .vf-result-icon { color: #9CA3FF; }

        /* Modal Overlay */
        .modal-overlay { position: fixed; inset: 0; background: rgba(11, 20, 55, 0.4); backdrop-filter: blur(10px); z-index: 5000; display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: 0.4s; }
        .modal-overlay.open { opacity: 1; visibility: visible; }
        .modal-card { background: var(--bg-card); width: 100%; max-width: 500px; padding: 40px; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); transform: translateY(20px); transition: 0.4s; }

        #notif-drawer { position: fixed; top: 0; right: -420px; width: 400px; height: 100vh; background: var(--bg-card); box-shadow: -15px 0 40px rgba(0,0,0,0.1); z-index: 2000; transition: 0.4s; padding: 35px; border-left: 1px solid var(--border); }
        #notif-drawer.open { right: 0; }
        #notif-drawer { display: flex; flex-direction: column; }
        .notif-bell { position: relative; }
        .notif-badge { position: absolute; top: -6px; right: -6px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; background: var(--danger); color: #fff; font-size: 0.68rem; font-weight: 800; display: flex; align-items: center; justify-content: center; border: 2px solid var(--bg-card); font-variant-numeric: tabular-nums; }
        .notif-badge.hidden { display: none; }
        .notif-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
        .notif-summary { font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; }
        .notif-actions { display: flex; justify-content: space-between; margin-bottom: 12px; }
        #notif-list { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; margin: 0 -8px; padding: 0 8px 20px; }
        .notif-item { display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 12px; width: 100%; text-align: left; padding: 14px; border-radius: var(--radius-md); background: var(--bg-card); border: 1px solid var(--border); cursor: pointer; color: inherit; font: inherit; }
        .notif-item:hover { background: var(--bg-body); }
        .notif-item.unread { background: var(--primary-light); border-color: transparent; }
        .notif-item:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
        .notif-icon { width: 34px; height: 34px; border-radius: 10px; display: flex; align-items: center; justify-content: center; }
        .notif-icon svg { width: 17px; height: 17px; }
        .notif-icon.sev-info { background: #E0E7FF; color: #4338CA; }
        .notif-icon.sev-success { background: #DCFCE7; color: #059669; }
        .notif-icon.sev-warning { background: #FFF4E5; color: #B45309; }
        .notif-icon.sev-danger { background: #FEE2E2; color: #DC2626; }
        .notif-title { font-weight: 700; font-size: 0.88rem; color: var(--text-main); display: flex; align-items: center; gap: 6px; }
        .notif-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex-shrink: 0; }
        .notif-msg { font-size: 0.8rem; color: var(--text-muted); margin-top: 3px; line-height: 1.45; }
        .notif-time { font-size: 0.7rem; color: var(--text-muted); margin-top: 6px; font-weight: 600; }
        .notif-actions .ins-link:disabled { opacity: 0.4; cursor: default; }
        .notif-empty { text-align: center; color: var(--text-muted); padding: 40px 10px; font-size: 0.9rem; }
        body.dark-mode .notif-item.unread { background: #1A2251; }

        /* CRUD Specific Buttons */
        .btn-icon { width: 32px; height: 32px; border-radius: 8px; border: none; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; margin-right: 5px; }
        .btn-edit { background: var(--primary-light); color: var(--primary); }
        .btn-delete { background: #FEE2E2; color: var(--danger); }

        /* Toast */
        #toast-container { position: fixed; bottom: 30px; right: 30px; z-index: 9998; display: flex; flex-direction: column; gap: 10px; }
        .toast { padding: 16px 22px; border-radius: 14px; color: white; font-weight: 700; box-shadow: var(--shadow-sm); animation: fadeIn 0.3s ease; min-width: 260px; }
        .toast-success { background: var(--success); }
        .toast-error { background: var(--danger); }
        .toast-info { background: var(--primary); }

        /* ------------------------------------------------------------
           RESPONSIVE — same look/theme on every breakpoint, only the
           layout (columns, spacing, sidebar width) adapts to the
           available screen width so nothing overflows or gets cut off
           on tablets, small laptops, or small phones.
        ------------------------------------------------------------ */
        html { overflow-x: hidden; }
        img, canvas, svg { max-width: 100%; }
        .mobile-nav-toggle { display: none; }

        /* Shorter windows (laptops with browser chrome, split-screen, or any
           viewport where the sidebar's 11 nav items + logout don't all fit
           vertically) — tighten the sidebar's own spacing first. The aside's
           overflow-y: auto above is the fallback for anything still too
           short after this, so "Terminate" is always reachable either way. */
        @media (max-height: 820px) {
            aside { padding: 22px 20px; }
            aside > div:first-child { margin-bottom: 24px !important; }
            .nav-item { padding: 11px 18px; margin-bottom: 4px; font-size: 0.92rem; }
        }
        @media (max-height: 680px) {
            aside { padding: 16px 16px; }
            aside > div:first-child { margin-bottom: 16px !important; }
            .nav-item { padding: 9px 16px; margin-bottom: 2px; font-size: 0.88rem; }
        }

        /* Tablets / small laptops (iPad landscape, 13"-ish windows, split
           screen, etc.) — keep the desktop sidebar layout but tighten it
           up so 4-column grids don't get cramped. */
        @media (max-width: 1180px) and (min-width: 901px) {
            aside { width: 240px; padding: 32px 18px; }
            header { padding: 24px 28px; }
            main { padding: 0 28px 30px !important; }
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            #geofence > div[style*="grid-template-columns: 1fr 400px"] { grid-template-columns: 1fr 320px !important; }
        }

        @media (max-width: 900px) {
            body { overflow: auto; height: auto; min-height: 100vh; flex-direction: column; }

            .mobile-nav-toggle {
                display: flex; align-items: center; justify-content: center;
                width: 44px; height: 44px; border-radius: 14px; background: var(--bg-card);
                border: 1px solid var(--border); color: var(--text-main); cursor: pointer;
            }

            aside {
                position: fixed; inset: 0 25% 0 0; width: auto; max-width: 300px;
                transform: translateX(-105%); box-shadow: var(--shadow-lg); z-index: 3000;
            }
            aside.mobile-open { transform: translateX(0); }

            #main-wrapper { width: 100%; }
            header { padding: 20px; flex-wrap: wrap; gap: 12px; }
            header h2 { font-size: 1.3rem; }
            main { padding: 0 16px 30px !important; }

            .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
            .stat-card { padding: 16px; gap: 12px; }
            .stat-icon { width: 46px; height: 46px; }
            .stat-info span { font-size: 1.3rem; }

            /* Any inline two/three/four-column grid collapses to one column on phones */
            [style*="grid-template-columns"] { grid-template-columns: 1fr !important; }
            #geofence [style*="height: 720px"] { height: auto !important; }
            #geo-map { height: 320px; }

            .table-container { overflow-x: auto; }
            table { min-width: 640px; }

            .modal-card { max-width: calc(100vw - 32px); padding: 24px; max-height: 85vh; overflow-y: auto; }
            #notif-drawer { width: 85vw; right: -85vw; }

            .login-card { padding: 32px 24px; }
        }

        /* Small phones (≤460px) — everything above still applies; this just
           trims paddings/font sizes further so cards and the login screen
           don't feel oversized on a narrow screen. */
        @media (max-width: 460px) {
            .stats-grid { grid-template-columns: 1fr; }
            .card { padding: 18px; }
            header { padding: 16px; }
            header h2 { font-size: 1.15rem; }
            .login-card { padding: 26px 18px; }
            .modal-card { padding: 18px; }
            .btn-primary { padding: 12px 18px; font-size: 0.9rem; }
            th, td { padding: 14px 16px; font-size: 0.85rem; }
        }

        /* ------------------------------------------------------------
           MODERN LAYER — cleaner type, tighter radii, subtle depth and
           real hover/focus states. Colors come only from the :root
           tokens above, so the CSPC theme is unchanged.
        ------------------------------------------------------------ */
        body { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; font-size: 15px; }
        h1, h2, h3, h4, h5 { letter-spacing: -0.01em; }
        ::-webkit-scrollbar-thumb { background: var(--border); }
        ::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }
        :focus-visible { outline: none; box-shadow: var(--ring); }

        .card { padding: 24px; box-shadow: var(--shadow-sm); }

        /* Sidebar */
        aside { width: 264px; padding: 28px 18px; }
        aside > div:first-child h1 { font-size: 1.25rem !important; letter-spacing: -0.02em; }
        .nav-item { gap: 12px; padding: 11px 14px; border-radius: var(--radius-sm); font-weight: 600; font-size: 0.92rem; margin-bottom: 4px; transition: background 0.15s ease, color 0.15s ease; }
        .nav-item svg { width: 19px; height: 19px; flex-shrink: 0; }
        .nav-item:hover:not(.active) { background: var(--primary-light); color: var(--primary); }
        .nav-item.active { box-shadow: 0 6px 16px rgba(13, 0, 165, 0.22); }
        .nav-item.nav-logout { color: var(--danger) !important; background: transparent !important; border: 1px solid var(--border); margin-top: 16px; }
        .nav-item.nav-logout:hover { background: #FEE2E2 !important; border-color: #FECACA; }

        /* Top bar */
        header { padding: 24px 36px; }
        header h2 { font-weight: 700 !important; letter-spacing: -0.02em; }
        .nav-tool-btn { width: 42px; height: 42px; border-radius: var(--radius-sm); box-shadow: var(--shadow-sm); }
        .nav-tool-btn:hover { border-color: var(--primary); color: var(--primary); }

        /* Stat cards */
        .stats-grid { gap: 20px; }
        .stat-card { padding: 20px; gap: 16px; box-shadow: var(--shadow-sm); transition: var(--transition); }
        .stat-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
        .stat-icon { width: 52px; height: 52px; border-radius: 14px; }
        .stat-info span { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; }
        .stat-info h4 { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.04em; margin-bottom: 6px; }
        .mini-stat-card, .quick-action-btn { box-shadow: var(--shadow-sm); transition: var(--transition); }
        .mini-stat-card .mini-val { font-weight: 700; }
        .quick-action-btn:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
        .widget-title { font-weight: 700; }

        /* Tables */
        .table-container { box-shadow: var(--shadow-sm); }
        th { padding: 13px 20px; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em; white-space: nowrap; }
        td { padding: 14px 20px; font-size: 0.9rem; font-weight: 500; vertical-align: middle; }
        tbody tr { transition: background 0.12s ease; }
        tbody tr:hover td { background: var(--bg-body); }
        tbody tr:last-child td { border-bottom: none; }

        /* Badges */
        .badge, .badge-select, .liveness-badge { border-radius: 999px; padding: 4px 11px; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.03em; display: inline-flex; align-items: center; gap: 4px; }

        /* Forms */
        .geo-input { padding: 11px 14px; border-radius: var(--radius-sm); background: var(--bg-card); font-weight: 500; font-size: 0.92rem; }
        .geo-input:hover { border-color: var(--text-muted); }
        .geo-input:focus { border-color: var(--accent); box-shadow: var(--ring); }
        .geo-input::placeholder { color: var(--text-muted); font-weight: 400; }

        /* Buttons */
        .btn-primary { padding: 11px 20px; border-radius: var(--radius-sm); font-weight: 600; font-size: 0.9rem; box-shadow: 0 1px 2px rgba(13, 0, 165, 0.12); }
        .btn-primary:hover:not(:disabled) { filter: brightness(0.93); box-shadow: 0 6px 14px rgba(13, 0, 165, 0.18); }
        .btn-primary:active:not(:disabled) { transform: translateY(1px); }
        .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }
        .btn-primary svg { width: 17px; height: 17px; }
        .btn-icon { width: 34px; height: 34px; border-radius: 9px; transition: var(--transition); }
        .btn-icon:hover { filter: brightness(0.94); transform: translateY(-1px); }
        .btn-icon svg { width: 16px; height: 16px; }

        /* Modals, drawer, toasts */
        .modal-overlay { background: rgba(11, 20, 55, 0.45); backdrop-filter: blur(6px); transition: 0.2s; }
        .modal-card { padding: 32px; transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1); }
        .modal-overlay.open .modal-card { transform: none; }

        /* Add / Edit Employee modal: fixed header + footer, only the form scrolls */
        .modal-card.emp-modal { max-width: 720px; padding: 0; display: flex; flex-direction: column; max-height: calc(100vh - 48px); overflow: hidden; }
        .emp-modal-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding: 24px 28px 18px; border-bottom: 1px solid var(--border); }
        .emp-modal-head h2 { margin: 0; font-weight: 800; font-size: 1.35rem; }
        .emp-modal-head p { margin: 4px 0 0; font-size: 0.8rem; color: var(--text-muted); }
        .emp-modal-close { flex: none; width: 36px; height: 36px; display: grid; place-items: center; border-radius: 10px; border: 1px solid var(--border); background: transparent; color: var(--text-muted); cursor: pointer; transition: 0.15s; }
        .emp-modal-close:hover { background: var(--bg-body); color: var(--text-main); }
        .emp-modal-close svg { width: 18px; height: 18px; }
        .emp-modal-body { flex: 1; min-height: 0; overflow-y: auto; padding: 20px 28px 8px; display: grid; gap: 22px; scrollbar-width: thin; scrollbar-color: var(--border) transparent; overscroll-behavior: contain; }
        .emp-modal-body::-webkit-scrollbar { width: 10px; }
        .emp-modal-body::-webkit-scrollbar-track { background: transparent; }
        .emp-modal-body::-webkit-scrollbar-thumb { background: var(--border); border-radius: 10px; border: 3px solid var(--bg-card); }
        .emp-modal-body::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }
        .emp-section { display: grid; gap: 12px; }
        .emp-section-title { margin: 0; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--primary); padding-bottom: 8px; border-bottom: 1px dashed var(--border); }
        .emp-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 16px; }
        .emp-span-2 { grid-column: 1 / -1; }
        .emp-field { display: grid; gap: 6px; align-content: start; }
        .emp-field label { font-size: 0.7rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
        .emp-field .geo-input { margin: 0; }
        .emp-label-row { display: flex; justify-content: space-between; align-items: baseline; }
        .emp-inline-link { font-size: 0.72rem; font-weight: 700; color: var(--primary); text-decoration: none; }
        .emp-inline-link:hover { text-decoration: underline; }
        .emp-device { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 16px; padding: 14px 16px; border-radius: 12px; background: var(--primary-light); }
        .emp-device + .emp-device { margin-top: 8px; }
        .emp-device dt { font-size: 0.66rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--text-muted); }
        .emp-device dd { margin: 2px 0 0; font-size: 0.85rem; font-weight: 600; color: var(--text-main); overflow-wrap: anywhere; }
        .emp-device .emp-device-id { font-family: ui-monospace, "Cascadia Mono", Consolas, monospace; font-size: 0.8rem; }
        .emp-modal-foot { display: flex; gap: 12px; padding: 16px 28px; border-top: 1px solid var(--border); background: var(--bg-card); }
        .emp-modal-foot .btn-primary { margin: 0; }
        .emp-btn-cancel { flex: 1; background: var(--bg-body) !important; color: var(--text-main) !important; border: 1px solid var(--border) !important; box-shadow: none !important; }
        .emp-btn-save { flex: 2; }

        /* ================= Dashboard ================= */
        #dashboard { display: none; flex-direction: column; gap: 24px; padding-top: 4px; }
        #dashboard.active { display: flex; }
        .dash-hero { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; padding: 26px 28px; border-radius: var(--radius-xl); color: #fff;
            background: radial-gradient(120% 140% at 100% 0%, rgba(124, 107, 255, 0.55) 0%, rgba(124, 107, 255, 0) 55%), linear-gradient(135deg, #0D00A5 0%, #2A0FD6 100%); box-shadow: var(--shadow-lg); }
        .dash-date { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.75; }
        .dash-greeting { font-size: clamp(1.4rem, 2.4vw, 1.9rem); font-weight: 800; letter-spacing: -0.02em; margin-top: 4px; text-wrap: balance; }
        .dash-hero-sub { font-size: 0.9rem; opacity: 0.8; margin-top: 4px; }
        .dash-live-chip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 999px; background: rgba(255, 255, 255, 0.14); border: 1px solid rgba(255, 255, 255, 0.22); font-size: 0.8rem; font-weight: 700; white-space: nowrap; }
        .dash-live-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255, 255, 255, 0.5); }
        .dash-live-chip.is-live .dash-live-dot { background: #34F5B9; box-shadow: 0 0 0 0 rgba(52, 245, 185, 0.6); animation: dashPulse 1.8s infinite; }
        @keyframes dashPulse { 0% { box-shadow: 0 0 0 0 rgba(52, 245, 185, 0.55); } 70% { box-shadow: 0 0 0 8px rgba(52, 245, 185, 0); } 100% { box-shadow: 0 0 0 0 rgba(52, 245, 185, 0); } }

        .dash-live-events { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
        .dash-live-card { display: grid; gap: 10px; text-align: left; padding: 18px 20px; border-radius: var(--radius-lg); border: 1px solid var(--border); background: var(--bg-card); box-shadow: var(--shadow-sm); cursor: pointer; color: var(--text-main); font: inherit; transition: var(--transition); }
        .dash-live-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); border-color: var(--chart-1); }
        .dash-live-card:focus-visible { outline: none; box-shadow: var(--ring); }
        .dash-live-card .dash-live-tag { display: inline-flex; align-items: center; gap: 6px; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--success); }
        .dash-live-card h4 { font-size: 1rem; font-weight: 800; }
        .dash-live-card p { font-size: 0.78rem; color: var(--text-muted); }
        .dash-live-card .dash-live-count { display: flex; justify-content: space-between; font-size: 0.8rem; font-weight: 700; font-variant-numeric: tabular-nums; }

        .dash-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
        .dash-kpi { display: grid; gap: 6px; align-content: start; padding: 20px 22px; border-radius: var(--radius-lg); border: 1px solid var(--border); background: var(--bg-card); box-shadow: var(--shadow-sm); transition: var(--transition); }
        .dash-kpi:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
        .dash-kpi-top { display: flex; justify-content: space-between; align-items: center; }
        .dash-kpi-label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--text-muted); }
        .dash-kpi-icon { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; background: var(--primary-light); color: var(--primary); }
        body.dark-mode .dash-kpi-icon { color: #9CA3FF; }
        .dash-kpi-icon svg { width: 18px; height: 18px; }
        .dash-kpi-icon.tone-good { background: rgba(5, 205, 153, 0.14); color: var(--success); }
        .dash-kpi-icon.tone-warn { background: rgba(255, 181, 71, 0.18); color: #B7791F; }
        body.dark-mode .dash-kpi-icon.tone-warn { color: var(--warning); }
        .dash-kpi-value { font-size: 2rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; font-variant-numeric: tabular-nums; }
        .dash-kpi-foot { font-size: 0.78rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
        .dash-meter { height: 8px; border-radius: 999px; background: var(--chart-track); overflow: hidden; margin: 4px 0 2px; }
        .dash-meter span { display: block; height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--chart-1), #7C6BFF); transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1); }

        .dash-chips { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
        .dash-chip { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border-radius: var(--radius-md); border: 1px solid var(--border); background: var(--bg-card); color: var(--text-main); font: inherit; cursor: pointer; text-align: left; transition: var(--transition); }
        .dash-chip:hover { border-color: var(--chart-1); box-shadow: var(--shadow-sm); }
        .dash-chip:focus-visible { outline: none; box-shadow: var(--ring); }
        .dash-chip svg { width: 18px; height: 18px; color: var(--text-muted); flex: none; }
        .dash-chip b { font-size: 1.1rem; font-weight: 800; font-variant-numeric: tabular-nums; }
        .dash-chip span { font-size: 0.78rem; color: var(--text-muted); font-weight: 600; }

        .dash-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
        .dash-row.dash-row-wide { grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); }
        .dash-panel { display: flex; flex-direction: column; gap: 16px; }
        .dash-panel-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
        .dash-panel-head h3 { font-size: 1rem; font-weight: 800; margin: 0; }
        .dash-panel-head p { font-size: 0.78rem; color: var(--text-muted); margin-top: 2px; }
        .dash-legend { display: flex; gap: 14px; font-size: 0.78rem; font-weight: 600; color: var(--text-muted); }
        .dash-legend span { display: inline-flex; align-items: center; gap: 6px; }
        .dash-swatch { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
        .dash-chart-box { position: relative; height: 240px; }
        .dash-empty-note { font-size: 0.8rem; color: var(--text-muted); text-align: center; margin-top: -8px; }
        .dash-filters { display: flex; gap: 8px; flex-wrap: wrap; }
        .dash-filters .geo-input { margin: 0; width: auto; max-width: 220px; font-size: 0.8rem; padding: 8px 12px; }
        .dash-link { display: inline-flex; align-items: center; gap: 6px; background: none; border: 0; color: var(--accent); font: inherit; font-size: 0.78rem; font-weight: 700; cursor: pointer; padding: 4px 0; }
        .dash-link svg { width: 14px; height: 14px; }
        .dash-link:hover { text-decoration: underline; }
        body.dark-mode .dash-link { color: #9CA3FF; }

        .dash-attn { list-style: none; display: grid; gap: 8px; }
        .dash-attn-item { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: var(--radius-md); border: 1px solid var(--border); background: var(--bg-body); }
        .dash-attn-item button { all: unset; display: flex; align-items: center; gap: 12px; width: 100%; cursor: pointer; }
        .dash-attn-item:has(button):hover { border-color: var(--chart-1); }
        .dash-attn-item:has(button:focus-visible) { box-shadow: var(--ring); }
        .dash-attn-icon { width: 34px; height: 34px; border-radius: 10px; display: grid; place-items: center; flex: none; }
        .dash-attn-icon svg { width: 17px; height: 17px; }
        .dash-attn-icon.sev-warn { background: rgba(255, 181, 71, 0.18); color: #B7791F; }
        .dash-attn-icon.sev-crit { background: rgba(238, 93, 80, 0.14); color: var(--danger); }
        .dash-attn-icon.sev-ok { background: rgba(5, 205, 153, 0.14); color: var(--success); }
        body.dark-mode .dash-attn-icon.sev-warn { color: var(--warning); }
        .dash-attn-text { flex: 1; min-width: 0; }
        .dash-attn-text b { display: block; font-size: 0.86rem; font-weight: 700; color: var(--text-main); }
        .dash-attn-text span { font-size: 0.74rem; color: var(--text-muted); }
        .dash-attn-count { font-size: 1.1rem; font-weight: 800; font-variant-numeric: tabular-nums; color: var(--text-main); }

        .dash-dept-list { display: grid; gap: 14px; }
        .dash-dept-row { display: grid; gap: 6px; }
        .dash-dept-row-top { display: flex; justify-content: space-between; gap: 12px; font-size: 0.84rem; }
        .dash-dept-row-top b { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .dash-dept-row-top span { color: var(--text-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
        .dash-dept-row-top span strong { color: var(--text-main); }
        .dash-dept-bar { height: 10px; border-radius: 999px; background: var(--chart-track); overflow: hidden; }
        .dash-dept-bar span { display: block; height: 100%; border-radius: 999px; background: var(--chart-1); transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1); }

        .dash-donut { display: grid; grid-template-columns: minmax(0, 170px) minmax(0, 1fr); gap: 20px; align-items: center; }
        .dash-donut-canvas { position: relative; width: 100%; aspect-ratio: 1; max-width: 170px; }
        .dash-donut-center { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; pointer-events: none; }
        .dash-donut-center b { font-size: 1.6rem; font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1; }
        .dash-donut-center span { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; }
        .dash-donut-legend { list-style: none; display: grid; gap: 10px; }
        .dash-donut-legend li { display: grid; grid-template-columns: 10px 1fr auto; align-items: center; gap: 10px; font-size: 0.84rem; }
        .dash-donut-legend li span { color: var(--text-main); font-weight: 600; }
        .dash-donut-legend li em { font-style: normal; color: var(--text-muted); font-variant-numeric: tabular-nums; }
        .dash-donut-legend li em strong { color: var(--text-main); }

        .dash-section { display: grid; gap: 14px; }
        .dash-section-title { font-size: 0.78rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }

        @media (max-width: 1200px) {
            .dash-kpis, .dash-chips { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .dash-row, .dash-row.dash-row-wide { grid-template-columns: minmax(0, 1fr); }
        }
        @media (max-width: 560px) {
            .dash-kpis, .dash-chips { grid-template-columns: minmax(0, 1fr); }
            .dash-hero { padding: 20px; }
            .dash-donut { grid-template-columns: minmax(0, 1fr); justify-items: center; }
            .dash-donut-legend { width: 100%; }
        }
        @media (prefers-reduced-motion: reduce) {
            .dash-live-chip.is-live .dash-live-dot { animation: none; }
            .dash-kpi:hover, .dash-live-card:hover { transform: none; }
        }


        /* ---- Dashboard refresh: CSPC navy + gold hero, stacked side columns ---- */
        /* The global `header { padding: 30px 45px }` (page top bar) was also
           padding every panel's <header>, pushing titles out of line. */
        .dash-panel-head { padding: 0; }
        .dash-hero { position: relative; overflow: hidden; display: grid; gap: 22px; align-items: stretch; justify-content: stretch; padding: 28px 30px 24px;
            background: radial-gradient(90% 140% at 100% 0%, rgba(90, 120, 255, 0.35) 0%, rgba(90, 120, 255, 0) 60%), linear-gradient(135deg, #0F1C6B 0%, #1D3494 60%, #2440B0 100%);
            border-bottom: 3px solid #D4A94A; }
        .dash-hero::after { content: ''; position: absolute; top: 0; right: 0; width: 180px; height: 100%; pointer-events: none;
            background: linear-gradient(115deg, transparent 0 46%, #D4A94A 46% 51%, transparent 51% 58%, rgba(243, 215, 122, 0.85) 58% 60.5%, transparent 60.5%); }
        .dash-hero-mark { position: absolute; right: 200px; top: 50%; width: 124px; height: 124px; transform: translateY(-50%); pointer-events: none; padding: 8px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 4px rgba(212, 169, 74, 0.85), 0 12px 28px rgba(0, 0, 0, 0.28); object-fit: contain; }
        .dash-hero-top { position: relative; z-index: 1; padding-right: 350px; display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
        .dash-hero .dash-date { color: #F3D77A; opacity: 1; }
        .dash-hero-actions { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: 10px; }
        .dash-hero-btn { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.22);
            background: rgba(255, 255, 255, 0.1); color: #fff; font: inherit; font-size: 0.8rem; font-weight: 700; cursor: pointer; transition: var(--transition); }
        .dash-hero-btn svg { width: 16px; height: 16px; }
        .dash-hero-btn:hover { background: rgba(255, 255, 255, 0.2); border-color: rgba(243, 215, 122, 0.7); }
        .dash-hero-btn:focus-visible { outline: 2px solid #F3D77A; outline-offset: 2px; }

        .dash-kpi { position: relative; overflow: hidden; }
        .dash-kpi::before { content: ''; position: absolute; left: 0; top: 0; right: 0; height: 3px; background: var(--chart-1); opacity: 0.85; }
        .dash-kpi:has(.tone-good)::before { background: var(--success); }
        .dash-kpi:has(.tone-warn)::before { background: var(--warning); }
