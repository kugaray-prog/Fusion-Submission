                            <input type="text" placeholder="Search resources..." class="geo-input" style="max-width: 350px; margin: 0;" onkeyup="G_App.employees.filter(this.value)">
                            <select id="filter-dept" class="geo-input" style="max-width: 250px; margin: 0;" onchange="G_App.employees.render()">
                                <option value="all">All Departments</option>
                            </select>
                            <select id="filter-classification" class="geo-input" style="max-width: 200px; margin: 0;" onchange="G_App.employees.render()">
                                <option value="all">All Classifications</option>
                                <option value="Permanent Administrative">Permanent Administrative</option>
                                <option value="Permanent Academic">Permanent Academic</option>
                                <option value="Casual Administrative">Casual Administrative</option>
                                <option value="COS Administrative">COS Administrative</option>
                                <option value="COS Academic">COS Academic</option>
                                <option value="Job Order">Job Order</option>
                            </select>
                        </div>
                        <div style="display:flex; gap:10px; flex-wrap: wrap;">
                            <button class="btn-primary" style="background: var(--success);" onclick="G_App.employees.exportFile('csv')"><i data-lucide="download"></i> CSV</button>
                            <button class="btn-primary" style="background: var(--secondary);" onclick="G_App.employees.exportFile('excel')"><i data-lucide="download"></i> Excel</button>
                            <button class="btn-primary" style="background: var(--warning);" onclick="G_App.employeeImport.openModal()"><i data-lucide="upload"></i> Batch Import</button>
                            <button class="btn-primary" onclick="G_App.employees.openModal()"><i data-lucide="user-plus"></i> Add New Employee</button>
                        </div>
                    </div>
                    <div class="table-container">
                        <table>
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Employee ID</th>
                                    <th>Department/Office</th>
                                    <th>Position</th>
                                    <th>Classification</th>
                                    <th>Status</th>
                                    <th>Remark</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="employee-table-body"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- MODAL: BATCH IMPORT EMPLOYEES -->
            <div id="import-modal" class="modal-overlay">
                <div class="modal-card" style="max-width: 780px; width: 92vw;">
                    <h2 style="margin-bottom: 10px; font-weight: 800;">Batch Import Employees</h2>
                    <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 20px;">Upload a CSV or Excel (.xlsx) file. Columns: Employee ID, Surname, Given Name, Middle Name, Suffix, Department, Position, Email, Phone, Status, Classification.</p>
                    <input type="file" id="import-file-input" accept=".csv,.xlsx,.xls" class="geo-input" onchange="G_App.employeeImport.preview()">
                    <div id="import-preview-summary" class="hidden" style="margin: 15px 0; display:flex; gap:12px; flex-wrap: wrap;"></div>
                    <div id="import-preview-table-wrap" class="table-container hidden" style="max-height: 320px; overflow-y: auto;">
                        <table>
                            <thead><tr><th>Row</th><th>Employee ID</th><th>Name</th><th>Department</th><th>Status</th></tr></thead>
                            <tbody id="import-preview-table"></tbody>
                        </table>
                    </div>
                    <div style="display: flex; gap: 15px; margin-top: 20px;">
                        <button class="btn-primary" style="background: var(--border); color: var(--text-main); flex: 1;" onclick="G_App.employeeImport.closeModal()">Cancel</button>
                        <button id="btn-import-commit" class="btn-primary hidden" style="flex: 2;" onclick="G_App.employeeImport.commit()">Import Valid Rows</button>
                    </div>
                </div>
