                            <div class="rpt-stat" style="border-color: var(--warning);"><span id="rpt-sum-late" style="color:var(--warning);">0</span><label>Late</label></div>
                            <div class="rpt-stat" style="border-color: var(--danger);"><span id="rpt-sum-absent" style="color:var(--danger);">0</span><label>Absent</label></div>
                        </div>

                        <!-- ATTENDANCE INSIGHTS — offices/colleges ranked by attendance (G_App.reports.renderInsights) -->
