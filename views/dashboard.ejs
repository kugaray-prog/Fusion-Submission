                    <button type="button" class="dash-chip" onclick="G_App.ui.switchView('departments')"><span class="dash-chip-icon"><i data-lucide="building-2"></i></span><b id="stat-departments">--</b><span>Departments</span><i data-lucide="chevron-right" class="dash-chip-go"></i></button>
                </section>

