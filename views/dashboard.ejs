                            <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; display: block;">Employee</label>
                            <select id="rpt-employee" class="geo-input" style="margin:0;">
                                <option value="all">All Personnel</option>
                            </select>
                        </div>
