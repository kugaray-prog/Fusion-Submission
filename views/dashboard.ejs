        .splash-mark { position: relative; width: 104px; height: 104px; transition: transform 0.45s ease; }
        .splash-logo { position: relative; z-index: 1; width: 104px; height: 104px; border-radius: 50%; background: #fff; padding: 8px; box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25); animation: splashBreath 1.8s ease-in-out infinite; }
        .splash-logo img { width: 100%; height: 100%; object-fit: contain; display: block; }
        .splash-ring { position: absolute; inset: 0; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.55); animation: splashRipple 1.8s cubic-bezier(0.2, 0.6, 0.4, 1) infinite; }
