                        <div>
                            <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; display: block;">Office/Dept</label>
                            <select id="rpt-dept" class="geo-input" style="margin:0;">
                                <option value="all">All Offices</option>
                            </select>
                        </div>
                        <div>
                            <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; display: block;">Year</label>
                            <select id="rpt-year" class="geo-input" style="margin:0;">
                                <% const reportYear = new Date().getFullYear(); for (let y = Math.min(2024, reportYear - 2); y <= reportYear + 1; y++) { %>
                                <option value="<%= y %>" <%= y === reportYear ? 'selected' : '' %>><%= y %></option>
                                <% } %>
                            </select>
                        </div>
                        <div>
                            <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 8px; display: block;">Month</label>
