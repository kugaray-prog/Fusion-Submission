                                <span><i class="dash-swatch" style="background:var(--chart-3)"></i>Late</span>
                            </div>
                        </header>
                        <div class="dash-chart-box"><canvas id="dashTrendChart" role="img" aria-label="Present and late check-ins per day for the last 7 days"></canvas></div>
                        <p class="dash-empty-note" id="dash-trend-empty" hidden>No check-ins in the last 7 days yet.</p>
                    </article>
                    <div class="dash-stack">
                        <article class="card dash-panel">
                            <header class="dash-panel-head">
                                <div>
                                    <h3>Needs attention</h3>
                                    <p>Waiting on an admin</p>
                                </div>
                            </header>
                            <ul class="dash-attn" id="dash-attention">
                                <li class="dash-attn-item"><span>Loading…</span></li>
                            </ul>
                        </article>
                        <article class="card dash-panel dash-grow">
                            <header class="dash-panel-head">
                                <div><h3>Upcoming events</h3><p>Next on the schedule</p></div>
                                <button type="button" class="dash-link" onclick="G_App.ui.switchView('events')">View all <i data-lucide="arrow-right"></i></button>
                            </header>
                            <div id="dash-upcoming-events"><div class="mini-event-item"><h5>Loading…</h5></div></div>
                        </article>
                    </div>
                </section>

                <!-- Department attendance | classification + recent activity -->
                <section class="dash-row dash-row-wide">
                    <article class="card dash-panel">
                        <header class="dash-panel-head">
                            <div>
                                <h3>Attendance by department</h3>
                                <p>Employees who attended, out of each department's total</p>
                            </div>
                            <div class="dash-filters">
                                <select id="dash-dept-event" class="geo-input" aria-label="Event" onchange="G_App.ui.loadDepartmentAttendanceChart()">
                                    <option value="">All events</option>
                                </select>
                                <select id="dash-dept-classification" class="geo-input" aria-label="Classification" onchange="G_App.ui.loadDepartmentAttendanceChart()">
                                    <option value="all">All classifications</option>
                                    <option value="Permanent Administrative">Permanent Administrative</option>
                                    <option value="Permanent Academic">Permanent Academic</option>
                                    <option value="Casual Administrative">Casual Administrative</option>
                                    <option value="COS Administrative">COS Administrative</option>
                                    <option value="COS Academic">COS Academic</option>
                                    <option value="Job Order">Job Order</option>
                                </select>
                            </div>
                        </header>
                        <div class="dash-dept-list" id="dash-dept-list"></div>
                    </article>
                    <div class="dash-stack">
                        <article class="card dash-panel">
                            <header class="dash-panel-head">
                                <div>
                                    <h3>Employee classification</h3>
                                    <p>Approved employees by type</p>
                                </div>
                            </header>
                            <div class="dash-donut">
                                <div class="dash-donut-canvas">
                                    <canvas id="classificationChart" role="img" aria-label="Employees by classification"></canvas>
                                    <div class="dash-donut-center"><b id="dash-donut-total">--</b><span>employees</span></div>
                                </div>
                                <ul class="dash-donut-legend" id="dash-donut-legend"></ul>
                            </div>
                        </article>
                        <article class="card dash-panel dash-grow">
