        .lg-blob-2 { width: 300px; height: 300px; bottom: -110px; left: -70px; background: #5EE6C2; opacity: 0.35; animation: lgFloat 14s ease-in-out infinite reverse; }
        body.dark-mode .lg-blob { opacity: 0.22; }
        .lg-theme { position: absolute; z-index: 2; top: 24px; right: 24px; width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--border); background: var(--bg-card); color: var(--text-muted); display: grid; place-items: center; cursor: pointer; box-shadow: var(--shadow-sm); }
        .lg-theme:hover { color: var(--primary); transform: rotate(-20deg); }
        .lg-theme svg { width: 18px; height: 18px; }

        #login-screen .login-card { position: relative; z-index: 1; width: 100%; max-width: 440px; padding: 44px 40px 36px; border-radius: 28px; text-align: left; color: var(--text-main);
            background: color-mix(in srgb, var(--bg-card) 88%, transparent); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border); box-shadow: 0 1px 0 rgba(255, 255, 255, 0.6) inset, 0 40px 80px -30px rgba(13, 0, 165, 0.35), 0 12px 24px -12px rgba(27, 37, 89, 0.12); }
        body.dark-mode #login-screen .login-card { box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.6); }
        #login-screen .login-card > div:first-child { border: none; }

        .lg-brand { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: 30px; }
        .lg-brand-mark { position: relative; width: 84px; height: 84px; border-radius: 50%; padding: 4px; margin-bottom: 14px; background: conic-gradient(from 210deg, #0D00A5, #7C6BFF, #5EE6C2, #0D00A5); box-shadow: 0 16px 32px -12px rgba(13, 0, 165, 0.55); }
        .lg-brand-mark img { width: 100%; height: 100%; border-radius: 50%; background: #fff; padding: 5px; object-fit: contain; }
        .lg-brand h1 { font-size: 2rem; font-weight: 800 !important; line-height: 1.1; letter-spacing: -0.04em; background: linear-gradient(135deg, #0D00A5 10%, #4318FF 60%, #7C6BFF); -webkit-background-clip: text; background-clip: text; color: transparent !important; }
        body.dark-mode .lg-brand h1 { background: linear-gradient(135deg, #FFFFFF, #B9B3FF); -webkit-background-clip: text; background-clip: text; }
        .lg-by { margin-top: 10px; padding: 4px 12px; border-radius: 999px; background: var(--primary-light); color: var(--primary); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
        body.dark-mode .lg-by { color: #B9B3FF; }

        .lg-heading { text-align: center; margin-bottom: 26px; }
        .lg-greet { display: block; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); margin-bottom: 6px; }
        body.dark-mode .lg-greet { color: #9CA3FF; }
        .lg-heading h3 { font-size: 1.4rem; font-weight: 700; color: var(--text-main); letter-spacing: -0.02em; margin-bottom: 6px; }
        #login-screen .lg-heading p { font-size: 0.9rem; color: var(--text-muted); margin: 0; }

        #login-screen .login-error { min-height: 0; margin: 0; }
        #login-screen .login-error:not(:empty) { margin-bottom: 14px; padding: 11px 14px; border-radius: 12px; background: rgba(238, 93, 80, 0.1); border: 1px solid rgba(238, 93, 80, 0.25); font-size: 0.85rem; text-align: center; }
        .lg-google { padding: 6px; border-radius: 14px; background: linear-gradient(135deg, rgba(13, 0, 165, 0.08), rgba(94, 230, 194, 0.14)); }
        body.dark-mode .lg-google { background: rgba(255, 255, 255, 0.05); }
        #login-screen .google-signin-slot { justify-content: center; min-height: 44px; }
        .lg-note { display: flex; gap: 10px; margin-top: 16px; padding: 12px 14px; border-radius: 12px; background: var(--bg-body); border: 1px solid var(--border); color: var(--text-main); font-size: 0.8rem; line-height: 1.5; }
        .lg-note svg { width: 18px; height: 18px; flex-shrink: 0; color: var(--success); margin-top: 1px; }
        .lg-note-warn svg { color: var(--warning); }
        .lg-trust { list-style: none; display: flex; justify-content: center; flex-wrap: wrap; gap: 6px 18px; margin-top: 24px; padding-top: 20px; border-top: 1px dashed var(--border); }
        .lg-trust li { display: inline-flex; align-items: center; gap: 6px; font-size: 0.75rem; font-weight: 600; color: var(--text-muted); }
        .lg-trust svg { width: 14px; height: 14px; }

        .lg-foot { position: relative; z-index: 1; font-size: 0.78rem; color: var(--text-muted); text-align: center; }
        .lg-foot span { margin: 0 6px; }
        .lg-foot strong { color: var(--text-main); }

        /* Entrance */
        body.splash-done #login-screen .lg-hero-copy { animation: loginRise 0.8s cubic-bezier(0.2, 0.7, 0.3, 1) both 0.1s; }
        body.splash-done #login-screen .lg-hero-top { animation: loginRise 0.8s cubic-bezier(0.2, 0.7, 0.3, 1) both; }

        @media (max-width: 1200px) {
            .lg-hero { padding: 36px; }
            .lg-float-b { display: none; }
            .lg-radar { width: 300px; height: 300px; }
        }
        @media (max-width: 960px) {
            #login-screen { display: block; }
            .lg-hero { margin: 10px 10px 0; min-height: 280px; padding: 22px 20px 52px; border-radius: 24px; justify-content: flex-start; gap: 34px; }
            .lg-float, .lg-chips, .lg-hero-copy p { display: none; }
            .lg-radar { top: 30%; left: 82%; width: 220px; height: 220px; opacity: 0.8; }
            .lg-hero-copy h2 { font-size: 1.7rem; margin-bottom: 0; }
            .lg-eyebrow { margin-bottom: 12px; }
            .lg-hero-top img { width: 40px; height: 40px; }
            .lg-hero-top strong { font-size: 0.7rem; }
            .lg-panel { overflow: visible; margin-top: -40px; padding: 0 16px 28px; gap: 22px; }
            .lg-panel::before, .lg-blob { display: none; }
            .lg-theme { position: fixed; top: 22px; right: 22px; }
            #login-screen .login-card { padding: 30px 22px 26px; border-radius: 24px; }
            .lg-brand-mark { width: 72px; height: 72px; }
        }
        @media (prefers-reduced-motion: reduce) {
            .lg-hero-photo, .lg-radar *, .lg-float, .lg-blob, .lg-live { animation: none !important; }
        }
    </style>
</head>
<body class="light-mode">
    <!-- SPLASH (first thing painted on load/reload) -->
    <div id="app-splash" role="status" aria-live="polite">
        <div class="splash-mark" aria-hidden="true">
            <span class="splash-ring"></span><span class="splash-ring"></span><span class="splash-ring"></span>
            <div class="splash-logo"><img src="/img/cspc-logo.png" alt=""></div>
        </div>
        <div class="splash-name">GeoAttend</div>
        <div class="splash-sub" id="splash-text">CSPC Admin Portal</div>
        <div class="splash-bar" aria-hidden="true"><span></span></div>
        <span class="sr-only" style="position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0);">Loading</span>
    </div>

    <div id="toast-container"></div>

    <!-- CONFIRM DIALOG (confirmDialog() in app.js) -- replaces the browser's confirm() -->
    <div id="confirm-modal" class="modal-overlay" aria-hidden="true">
        <div class="modal-card confirm-card" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title" aria-describedby="confirm-message">
            <span id="confirm-icon" class="confirm-icon"><i data-lucide="trash-2"></i></span>
            <h2 id="confirm-title" class="confirm-title"></h2>
            <p id="confirm-message" class="confirm-message"></p>
            <div class="confirm-actions">
                <button type="button" class="btn-primary confirm-cancel" id="confirm-cancel">Cancel</button>
                <button type="button" class="btn-primary" id="confirm-ok">Delete</button>
            </div>
        </div>
    </div>

    <!-- NOTIFICATION DRAWER -->
    <div id="notif-drawer">
        <div class="notif-head">
            <div>
                <h3 style="font-weight: 800; font-size: 1.4rem;">Notifications</h3>
                <p id="notif-summary" class="notif-summary"></p>
            </div>
            <button class="nav-tool-btn" aria-label="Close notifications" onclick="G_App.ui.toggleNotifs()"><i data-lucide="x"></i></button>
        </div>
        <div class="notif-actions">
            <button type="button" class="ins-link" id="notif-read-all" onclick="G_App.notifications.markAllRead()">Mark all as read</button>
            <button type="button" class="ins-link" id="notif-clear" onclick="G_App.notifications.clearRead()">Clear read</button>
        </div>
        <div id="notif-list" aria-live="polite"></div>
    </div>

    <!-- MODAL PARA SA CRUD (CREATE/EDIT) -->
    <div id="crud-modal" class="modal-overlay">
        <div class="modal-card emp-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
            <div class="emp-modal-head">
                <div>
                    <h2 id="modal-title">Add Employee</h2>
                    <p>Fields marked * are required.</p>
                </div>
                <button type="button" class="emp-modal-close" aria-label="Close" onclick="G_App.employees.closeModal()"><i data-lucide="x"></i></button>
            </div>
            <div class="emp-modal-body">
            <input type="hidden" id="inp-id">

            <section class="emp-section">
                <h3 class="emp-section-title">Personal details</h3>
                <div class="emp-grid">
                    <div class="emp-field">
                        <label for="inp-code">Employee ID *</label>
                        <input type="text" id="inp-code" class="geo-input" placeholder="e.g. E004" required>
                    </div>
                    <div class="emp-field">
                        <label for="inp-gender">Gender *</label>
                        <select id="inp-gender" class="geo-input" onchange="G_App.employees.toggleOther('inp-gender')">
                            <option value="">Select gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Others">Others</option>
                        </select>
                        <input type="text" id="inp-gender-other" class="geo-input" placeholder="Enter gender" style="display: none;">
                    </div>
                    <div class="emp-field">
                        <label for="inp-surname">Surname *</label>
                        <input type="text" id="inp-surname" class="geo-input" placeholder="Surname" required>
                    </div>
                    <div class="emp-field">
                        <label for="inp-given-name">Given name *</label>
                        <input type="text" id="inp-given-name" class="geo-input" placeholder="Given name" required>
                    </div>
                    <div class="emp-field">
                        <label for="inp-middle-name">Middle name</label>
                        <input type="text" id="inp-middle-name" class="geo-input" placeholder="Optional">
                    </div>
                    <div class="emp-field">
                        <label for="inp-suffix">Suffix</label>
                        <select id="inp-suffix" class="geo-input">
                            <option value="">None</option>
                            <option value="Jr.">Jr.</option>
                            <option value="Sr.">Sr.</option>
                            <option value="II">II</option>
                            <option value="III">III</option>
                            <option value="IV">IV</option>
                            <option value="V">V</option>
                        </select>
                    </div>
                    <div class="emp-field emp-span-2">
                        <label for="inp-email">Email address</label>
                        <input type="email" id="inp-email" class="geo-input" placeholder="juan.delacruz@my.cspc.edu.ph">
                    </div>
                </div>
            </section>

            <section class="emp-section">
                <h3 class="emp-section-title">Employment</h3>
                <div class="emp-grid">
                    <div class="emp-field emp-span-2">
                        <div class="emp-label-row">
                            <label for="inp-dept">Department *</label>
                            <a href="javascript:void(0)" class="emp-inline-link" onclick="G_App.departments.openModal()">+ Add new</a>
                        </div>
                        <select id="inp-dept" class="geo-input"></select>
                    </div>
            <!-- Position / Gender / Classification mirror the mobile app's registration
                 form (mobile/src/screens/RegistrationScreen.js POSITION_OPTIONS,
                 GENDER_OPTIONS, CLASSIFICATION_OPTIONS) -- keep the lists in sync.
                 "Others" reveals a free-text field, same as the mobile picker. -->
                    <div class="emp-field">
            <div class="emp-label-row">
                <label for="inp-position">Position *</label>
                <a href="javascript:void(0)" class="emp-inline-link" onclick="G_App.employeeOptions.openModal('position')">+ Add new</a>
            </div>
            <select id="inp-position" class="geo-input" onchange="G_App.employees.toggleOther('inp-position')">
                <option value="">Select position</option>
                <option value="Instructor I">Instructor I</option>
                <option value="Instructor II">Instructor II</option>
                <option value="Instructor III">Instructor III</option>
                <option value="Assistant Professor">Assistant Professor</option>
                <option value="Associate Professor">Associate Professor</option>
                <option value="Professor">Professor</option>
                <option value="Department Dean">Department Dean</option>
                <option value="Program Chair">Program Chair</option>
                <option value="Guidance Counselor">Guidance Counselor</option>
                <option value="Librarian">Librarian</option>
                <option value="Registrar Staff">Registrar Staff</option>
                <option value="Accounting Staff">Accounting Staff</option>
                <option value="Administrative Aide I">Administrative Aide I</option>
                <option value="Administrative Aide II">Administrative Aide II</option>
                <option value="Administrative Aide III">Administrative Aide III</option>
                <option value="Administrative Officer">Administrative Officer</option>
                <option value="Administrative Assistant">Administrative Assistant</option>
                <option value="Others">Others</option>
            </select>
            <input type="text" id="inp-position-other" class="geo-input" placeholder="Enter position" style="display: none;">
                    </div>
                    <div class="emp-field">
                        <label for="inp-status">Employment status</label>
                        <select id="inp-status" class="geo-input">
                            <option value="Full-time">Full-time</option>
                            <option value="Part-time">Part-time</option>
                            <option value="COS">COS (Contract of Service)</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                    <div class="emp-field">
            <div class="emp-label-row">
                <label for="inp-classification">Classification *</label>
                <a href="javascript:void(0)" class="emp-inline-link" onclick="G_App.employeeOptions.openModal('classification')">+ Add new</a>
            </div>
            <select id="inp-classification" class="geo-input" onchange="G_App.employees.toggleOther('inp-classification')">
                <option value="Permanent Administrative">Permanent Administrative</option>
                <option value="Permanent Academic">Permanent Academic</option>
                <option value="Casual Administrative">Casual Administrative</option>
                <option value="COS Administrative">COS Administrative</option>
                <option value="COS Academic">COS Academic</option>
                <option value="Job Order">Job Order</option>
                <option value="Others">Others</option>
            </select>
            <input type="text" id="inp-classification-other" class="geo-input" placeholder="Enter classification" style="display: none;">
                    </div>
                    <div class="emp-field">
                        <label for="inp-remark">Remark</label>
                        <select id="inp-remark" class="geo-input">
                            <option value="Active">Active</option>
                            <option value="On Leave">On Leave</option>
                        </select>
                    </div>
                </div>
            </section>

            <!-- Device info exactly as the mobile registration form showed it
                 (RegistrationScreen.js device card) -- filled in when editing a
                 member who registered from the app; hidden otherwise. -->
            <section class="emp-section" id="inp-device-info-wrap" style="display: none;">
                <h3 class="emp-section-title">Registered device</h3>
                <div id="inp-device-info"></div>
            </section>
            </div>
            <div class="emp-modal-foot">
                <button type="button" class="btn-primary emp-btn-cancel" onclick="G_App.employees.closeModal()">Cancel</button>
                <button type="button" class="btn-primary emp-btn-save" id="btn-save-member" onclick="G_App.employees.save()">Save Member</button>
            </div>
        </div>
    </div>

    <!-- LOGIN -->
    <!-- Sign-in: campus "story" panel on the left (duotone photo, animated
         geofence radar, floating status cards), sign-in card on the right.
         Stacks into a short banner above the card on phones. -->
    <div id="login-screen">
        <section class="lg-hero" aria-hidden="true">
            <div class="lg-hero-photo"></div>
            <div class="lg-hero-tint"></div>
            <div class="lg-hero-grid"></div>

            <div class="lg-radar">
                <span class="lg-radar-ring"></span>
                <span class="lg-radar-ring"></span>
                <span class="lg-radar-ring"></span>
                <span class="lg-radar-sweep"></span>
                <span class="lg-radar-pin"><i data-lucide="map-pin"></i></span>
            </div>

            <div class="lg-float lg-float-a">
                <span class="lg-float-icon lg-ok"><i data-lucide="map-pinned"></i></span>
                <div><strong>Inside geofence</strong><small>Main Campus &middot; verified</small></div>
            </div>
            <div class="lg-float lg-float-b">
                <span class="lg-float-icon lg-face"><i data-lucide="scan-face"></i></span>
                <div><strong>Face matched</strong><small>Identity confirmed</small></div>
            </div>
            <div class="lg-float lg-float-c">
                <span class="lg-live"></span>
                <div><strong>Live monitoring</strong><small>Events update in real time</small></div>
            </div>

            <div class="lg-hero-top">
                <img src="/img/cspc-logo.png" alt="">
                <div>
                    <strong>Camarines Sur Polytechnic Colleges</strong>
                    <small>Nabua, Camarines Sur</small>
                </div>
            </div>

            <div class="lg-hero-copy">
                <span class="lg-eyebrow"><span></span> Admin Portal</span>
                <h2>Attendance,<br><em>verified where it happens.</em></h2>
                <p>Geofenced check-ins, face verification and live reports for every CSPC event &mdash; all in one place.</p>
                <ul class="lg-chips">
                    <li><i data-lucide="map-pin"></i> Geo-fencing</li>
                    <li><i data-lucide="scan-face"></i> Face verification</li>
                    <li><i data-lucide="bar-chart-3"></i> Real-time reports</li>
                </ul>
            </div>
        </section>

        <section class="lg-panel">
            <div class="lg-blob lg-blob-1"></div>
            <div class="lg-blob lg-blob-2"></div>
            <button type="button" class="lg-theme" onclick="G_App.ui.toggleDarkMode()" aria-label="Toggle dark mode"><i data-lucide="moon"></i></button>

            <div class="login-card">
                <div class="lg-brand">
                    <div class="lg-brand-mark"><img src="/img/cspc-logo.png" alt="CSPC Logo"></div>
                    <h1>GeoAttend</h1>
                    <span class="lg-by">By: Fusion</span>
                </div>

                <div class="lg-heading">
                    <span class="lg-greet" id="lg-greet">Welcome back</span>
                    <h3>Sign in to the Admin Portal</h3>
                    <p>Manage employees, events and attendance for CSPC.</p>
                </div>

                <div class="login-error" id="login-error"></div>
                <% if (googleClientId) { %>
                <div class="lg-google">
                    <div id="google-signin-btn" class="google-signin-slot"></div>
                </div>
                <div class="lg-note">
                    <i data-lucide="shield-check"></i>
                    <span>Use your institutional Google account. It must already be an admin account.</span>
                </div>
                <% } else { %>
                <div class="lg-note lg-note-warn">
                    <i data-lucide="alert-triangle"></i>
                    <span>Google Sign-In is not configured. Set GOOGLE_CLIENT_ID in the server's .env.</span>
                </div>
                <% } %>

                <ul class="lg-trust">
                    <li><i data-lucide="lock"></i> Google SSO</li>
                    <li><i data-lucide="user-check"></i> Admins only</li>
                    <li><i data-lucide="building-2"></i> CSPC accounts</li>
                </ul>
            </div>

            <div class="lg-foot">
                &copy; 2026 &ndash; <%= new Date().getFullYear() %> CSPC GeoAttend <span>&bull;</span> Developed by <strong>Fusion</strong>
            </div>
        </section>
    </div>
    <script>
        // Time-of-day greeting above the sign-in heading.
        (function () {
            var h = new Date().getHours();
            var el = document.getElementById('lg-greet');
            if (el) el.textContent = h < 12 ? 'Good morning' : h < 18 ? 'Good afternoon' : 'Good evening';
        })();
    </script>
    <script>window.__GOOGLE_CLIENT_ID__ = "<%= googleClientId %>"; window.__EMAIL_DOMAIN__ = "<%= emailDomain %>";</script>
