                        <table>
                            <thead><tr><th>Name</th><th>Office</th><th>Members</th><th>Actions</th></tr></thead>
                            <tbody id="departments-table-body"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- MODAL: ADD DEPARTMENT -->
            <div id="dept-modal" class="modal-overlay">
                <div class="modal-card">
                    <h2 id="dept-modal-title" style="margin-bottom: 25px; font-weight: 800;">Add Department</h2>
                    <input type="hidden" id="dept-id">
                    <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; display: block;">Department Name *</label>
                    <input type="text" id="dept-name" class="geo-input" placeholder="e.g. College of Engineering">
                    <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; display: block;">Office</label>
                    <input type="text" id="dept-office" class="geo-input" placeholder="Defaults to the department name">
                    <label style="font-size: 0.7rem; font-weight: 800; color: var(--text-muted); text-transform: uppercase; margin-bottom: 5px; display: block;">Description</label>
                    <input type="text" id="dept-description" class="geo-input" placeholder="Optional">
                    <div style="display: flex; gap: 15px; margin-top: 10px;">
                        <button class="btn-primary" style="background: var(--border); color: var(--text-main); flex: 1;" onclick="G_App.departments.closeModal()">Cancel</button>
                        <button class="btn-primary" style="flex: 2;" id="dept-save-btn" onclick="G_App.departments.save()">Save Department</button>
                    </div>
                </div>
            </div>

            <!-- MODAL: EMPLOYEES OF ONE DEPARTMENT (opened from its name/office in the table) -->
            <div id="dept-members-modal" class="modal-overlay" onclick="if (event.target === this) G_App.departments.closeMembers()">
                <div class="modal-card dept-members-card" role="dialog" aria-modal="true" aria-labelledby="dept-members-title">
                    <div class="dept-members-head">
                        <div>
                            <h2 id="dept-members-title">Department</h2>
                            <p><span id="dept-members-sub"></span> <span id="dept-members-count"></span></p>
                        </div>
                        <button type="button" class="emp-modal-close" aria-label="Close" onclick="G_App.departments.closeMembers()"><i data-lucide="x"></i></button>
                    </div>
                    <div class="table-container dept-members-table">
                        <table>
                            <thead><tr><th>Name</th><th>Employee ID</th><th>Position</th><th>Classification</th><th>Status</th></tr></thead>
                            <tbody id="dept-members-body"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- MODAL: ADD / MANAGE POSITION OR CLASSIFICATION (G_App.employeeOptions) -->
            <div id="opt-modal" class="modal-overlay">
                <div class="modal-card opt-modal" role="dialog" aria-modal="true" aria-labelledby="opt-modal-title">
                    <h2 id="opt-modal-title">Add Position</h2>
                    <form class="opt-add" onsubmit="event.preventDefault(); G_App.employeeOptions.save();">
                        <label id="opt-input-label" for="opt-input">Position name</label>
                        <input type="text" id="opt-input" class="geo-input" maxlength="120" autocomplete="off">
                    </form>
                    <h3 id="opt-list-title" class="opt-list-title">All positions</h3>
                    <ul id="opt-list" class="opt-list"></ul>
                    <div class="opt-actions">
                        <button type="button" class="btn-primary opt-cancel" onclick="G_App.employeeOptions.closeModal()">Close</button>
                        <button type="button" class="btn-primary opt-save" onclick="G_App.employeeOptions.save()">Add</button>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <script>
        window.__GOOGLE_MAPS_API_KEY__ = "<%= googleMapsApiKey %>";
    </script>
    <script src="/js/app.js"></script>
</body>
</html>
