            <div class="nav-item" data-target="ratings"><i data-lucide="trophy"></i> Ratings</div>
            <div class="nav-item" data-target="mobile-app"><i data-lucide="smartphone"></i> Device Management</div>
            <div class="nav-item" data-target="settings"><i data-lucide="sliders"></i> Settings</div>
        </nav>
        <div class="nav-item nav-logout" onclick="G_App.auth.logout()"><i data-lucide="log-out"></i> Log Out</div>
    </aside>

    <!-- MAIN WRAPPER -->
    <div id="main-wrapper" class="hidden" style="flex: 1; flex-direction: column; overflow: hidden;">
        <header>
            <div style="display:flex; align-items:center; gap:16px;">
                <div class="mobile-nav-toggle" onclick="G_App.ui.toggleMobileNav()"><i data-lucide="menu"></i></div>
                <div><h2 id="view-title" style="font-weight: 800; font-size: 1.8rem;">Dashboard</h2><p id="view-subtitle" style="color: var(--text-muted); font-size: 0.95rem;">System Overview</p></div>
            </div>
            <div style="display: flex; gap: 18px; align-items: center;">
                <div class="nav-tool-btn" onclick="G_App.ui.toggleDarkMode()"><i data-lucide="sun"></i></div>
                <button type="button" class="nav-tool-btn notif-bell" id="notif-bell" aria-label="Notifications" onclick="G_App.ui.toggleNotifs()"><i data-lucide="bell"></i><span id="notif-badge" class="notif-badge hidden"></span></button>
                <div class="card" id="admin-name-badge" style="padding: 12px 24px; font-weight: 800; color: var(--primary); background: var(--primary-light); border: none;">Admin</div>
            </div>
        </header>

        <main style="padding: 0 45px 45px; overflow-y: auto; flex: 1;">

            <!-- DASHBOARD -->
            <div id="dashboard" class="view active">
                <!-- Greeting + live status + quick actions -->
                <section class="dash-hero">
