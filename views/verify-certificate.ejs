<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>Verify Certificate · GeoAttend</title>
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <style>
        :root { --navy: #13237A; --muted: #6B7280; --danger: #B42318; --success: #067647; --border: #E4E7EC; }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px 16px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif; background: #F4F7FE; color: #1B2559; }
        .card { width: 100%; max-width: 440px; background: #fff; border-radius: 20px; padding: 28px 24px;
            box-shadow: 0 12px 32px rgba(19, 35, 122, 0.12); }
        .head { text-align: center; }
        .head img { width: 64px; height: 64px; }
        h1 { font-size: 1.2rem; margin: 10px 0 4px; color: var(--navy); }
        p { font-size: 0.9rem; color: var(--muted); line-height: 1.5; }
        .status { margin: 20px 0 16px; padding: 12px 14px; border-radius: 12px; font-weight: 700; font-size: 0.95rem; }
        .status.ok { background: #ECFDF3; color: var(--success); }
        .status.bad { background: #FEF3F2; color: var(--danger); }
        dl { display: grid; grid-template-columns: auto 1fr; gap: 8px 14px; font-size: 0.9rem; }
        dt { color: var(--muted); font-weight: 600; }
        dd { font-weight: 700; overflow-wrap: anywhere; }
        .note { margin-top: 14px; font-size: 0.8rem; }
        h2 { font-size: 0.95rem; margin: 22px 0 6px; color: var(--navy); }
        form { display: flex; gap: 8px; margin-top: 16px; }
        input[type=text] { flex: 1; min-width: 0; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px;
            font-size: 0.95rem; text-transform: uppercase; letter-spacing: 1px; }
        button, .file-btn { padding: 10px 14px; border: 0; border-radius: 10px; background: var(--navy); color: #fff;
            font-weight: 700; font-size: 0.9rem; cursor: pointer; }
        .file-btn { display: inline-block; margin-top: 6px; }
        #file-input { display: none; }
        #file-result { margin-top: 10px; font-size: 0.85rem; font-weight: 700; }
        #file-result.ok { color: var(--success); }
        #file-result.bad { color: var(--danger); }
        a { color: var(--navy); }
    </style>
</head>
<body>
    <main class="card">
        <div class="head">
            <img src="/img/cspc-logo.png" alt="CSPC">
            <h1>Certificate Verification</h1>
            <p>Camarines Sur Polytechnic Colleges · GeoAttend</p>
        </div>

        <% if (cert) { %>
            <div class="status ok">✓ This is a genuine certificate issued by CSPC.</div>
            <dl>
                <dt>Awarded to</dt><dd><%= cert.full_name %></dd>
                <dt>Event</dt><dd><%= cert.event_title %></dd>
                <dt>Issued</dt><dd><%= new Date(cert.issued_date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }) %></dd>
                <dt>Certificate No.</dt><dd><%= cert.certificate_number %></dd>
                <dt>Code</dt><dd><%= cert.verification_code %></dd>
            </dl>
            <p class="note">If the name, event or date on the certificate you were shown differs from the details above, the certificate has been altered.</p>

            <% if (cert.file_hash) { %>
                <h2>Check a PDF copy</h2>
                <p>Choose the certificate PDF you received. Any change to the file, even a single character, makes it fail this check. The file stays private and is not stored.</p>
                <label class="file-btn" for="file-input">Choose PDF…</label>
                <input type="file" id="file-input" accept="application/pdf,.pdf">
                <div id="file-result"></div>
            <% } %>
            <% if (cert.pdf_path) { %>
                <p class="note"><a href="<%= cert.pdf_path %>" target="_blank" rel="noopener">Download the original certificate</a></p>
            <% } %>
        <% } else if (code) { %>
            <div class="status bad">✗ No certificate has the code <%= code %>.</div>
            <p>Check the code printed at the bottom of the certificate and try again. A certificate whose code is not found was not issued by this system.</p>
        <% } else { %>
            <p style="margin-top: 18px;">Scan the QR code on the certificate, or type the verification code printed at its bottom.</p>
        <% } %>

        <form action="/verify" method="get">
            <input type="text" name="code" placeholder="XXXX-XXXX-XXXX" value="<%= cert ? '' : code %>" aria-label="Verification code" autocomplete="off">
            <button type="submit">Verify</button>
        </form>
    </main>

    <% if (cert && cert.file_hash) { %>
    <script>
        document.getElementById('file-input').addEventListener('change', async (e) => {
            const file = e.target.files[0];
            const out = document.getElementById('file-result');
            if (!file) return;
            out.className = '';
            out.textContent = 'Checking…';
            try {
                const res = await fetch('/api/verify/<%= encodeURIComponent(cert.verification_code) %>/check', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/pdf' },
                    body: file
                });
                const json = await res.json();
                if (!res.ok) throw new Error(json.message || 'The file could not be checked.');
                out.className = json.data.match ? 'ok' : 'bad';
                out.textContent = json.data.match
                    ? '✓ "' + file.name + '" is the original, unaltered certificate.'
                    : '✗ "' + file.name + '" does not match the issued certificate. It has been edited or is a different file.';
            } catch (err) {
                out.className = 'bad';
                out.textContent = err.message;
            }
            e.target.value = '';
        });
    </script>
    <% } %>
</body>
</html>
